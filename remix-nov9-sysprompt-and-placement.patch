+
+    def test_no_position_claims_no_position(self):
+        s = grounding.describe_screen(dict(self.CTX))
+        self.assertIn("480x270", s)
+        self.assertNotIn("top-", s)
+        self.assertIn("isn't something you're told", s)
+
