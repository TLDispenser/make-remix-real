; Core — desktop companion. Godot display/body only; all logic lives in Python.
; Window settings verified against Godot 4.7 docs (see /RESEARCH_NOTES.md).

config_version=5

[application]

config/name="Core"
config/description="PC-as-avatar. Transparent, borderless body driven by the Python brain over ws://localhost:8765."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=320
window/size/viewport_height=400
window/size/resizable=false
window/size/borderless=true
window/size/transparent=true
window/per_pixel_transparency/allowed=true

[rendering]

viewport/transparent_background=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
