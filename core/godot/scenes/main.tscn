[gd_scene load_steps=4 format=3]

; Root: transparent Control filling the borderless window.
; Click anywhere on the avatar area and drag -> Window.start_drag
; (compositor-owned move, the Wayland-safe way).

[ext_resource type="Script" path="res://scripts/main.gd" id="1_main"]
[ext_resource type="Script" path="res://scripts/avatar.gd" id="2_avatar"]

[sub_resource type="StyleBoxFlat" id="bubble_style"]
bg_color = Color(0.06, 0.06, 0.1, 0.82)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10
content_margin_left = 10.0
content_margin_right = 10.0
content_margin_top = 8.0
content_margin_bottom = 8.0

[node name="Main" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 0
script = ExtResource("1_main")

[node name="Avatar" type="Node2D" parent="."]
unique_name_in_owner = true
position = Vector2(160, 150)
script = ExtResource("2_avatar")
; PLACEHOLDER visual — replace this node's scene/children with your art.
; Give whatever drives your visuals the `signal` API on Main (see scripts/main.gd).

[node name="Bubble" type="PanelContainer" parent="."]
unique_name_in_owner = true
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 8.0
offset_top = -96.0
offset_right = -8.0
offset_bottom = -8.0
grow_vertical = 0
mouse_filter = 2
theme_override_styles/panel = SubResource("bubble_style")

[node name="Text" type="Label" parent="Bubble"]
layout_mode = 2
autowrap_mode = 3
text = ""

[node name="Debug" type="Label" parent="."]
unique_name_in_owner = true
anchors_preset = 10
anchor_right = 1.0
offset_left = 8.0
offset_top = 4.0
offset_right = -8.0
offset_bottom = 22.0
grow_horizontal = 2
mouse_filter = 2
text = "brain offline"
horizontal_alignment = 2
theme_override_font_sizes/font_size = 11
