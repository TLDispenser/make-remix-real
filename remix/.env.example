# Copy to .env and fill what you have. Never commit .env (ground rule).
# Keys only in .env or environment. This file is the template.
# Naming note (2026-11-08): settings are REMIX_* now; the old CORE_* names
# are still read, so an existing .env keeps working until you rename.

# Left brain (System 1) — Jev early access key from console.typesafe.ai/keys
# RuleBrain fallback activates automatically when this is absent.
JEV_API_KEY=

# Right brain (System 2) — default is Z.ai's GLM-4.7-Flash: $0 forever.
# Free key from https://z.ai (or open.bigmodel.cn); put it here, no card needed.
REMIX_LLM_API_KEY=

# Right brain = provider POOL (see speech.py). Primary:
REMIX_LLM_BASE_URL=https://api.z.ai/api/paas/v4
REMIX_LLM_MODEL=glm-4.7-flash

# Swap/FALLBACK pool. speech.py rotates providers when one proves stuck
# (e.g. z.ai's intermittent free-tier 429 "1305"): after 2 failed attempts a
# provider cools down 10 min (REMIX_LLM_PROVIDER_COOLDOWN_S) and rotation
# happens immediately. Every provider in the pool must be $0 (ground rule).
# Gemini free-key how-to: aistudio.google.com -> Get API key.
# NOTE: gemini-2.5-flash is DEAD for new users (deprecated 2026-10); free-tier
# models verified from the pricing page 2026-11-06 (see RESEARCH_NOTES.md):
#   gemini-3.5-flash-lite  <- recommended (high-volume simple tasks; what
#                             2.5-flash routes into)
#   gemini-3.8-flash       <- smartest Flash, also free tier
#   gemini-3.6-flash       <- previous-gen Flash, also free tier
REMIX_LLM_BACKUP1_URL=https://generativelanguage.googleapis.com/v1beta/openai
REMIX_LLM_BACKUP1_MODEL=gemini-3.5-flash-lite
REMIX_LLM_BACKUP1_API_KEY=
# More backups: increment the number (BACKUP2_URL / _MODEL / _API_KEY).

# Phase 2: vitals feed (0 = real psutil — the default; 1 = synthetic demo)
REMIX_MOCK=0

# Jev credit budget (user: limited credits). Defaults are in config.py;
# tighten here if needed. Silent life never calls Jev, so these cap only
# reactions to user input / flagged events.
# REMIX_JEV_COOLDOWN_S=3
# REMIX_JEV_MAX_PER_HOUR=60
# REMIX_JEV_CACHE_TTL_S=300

# Face variety (Jev): sample from Jev's probabilities, discount recent faces.
# REMIX_JEV_FACE_TEMPERATURE=1.0   (lower = more predictable, higher = more varied)
# REMIX_JEV_REPEAT_PENALTY=0.55    (weight multiplier per recent repeat; 1 = off)
# Her faces cost Jev calls: one per exchange to react, plus one more when her line
# has 2+ beats (it needs her actual words). Both count toward REMIX_JEV_MAX_PER_HOUR.

# Voice out: espeak-ng (NOT an AI voice). Arch: pacman -S espeak-ng
# REMIX_TTS=1  REMIX_TTS_VOICE=en-us+f3  REMIX_TTS_SPEED=160  REMIX_TTS_PITCH=42
# REMIX_SUBTITLES=auto   # auto = captions only when she has no voice; always | never

# On-screen text rule (2026-11-08): her rare flavor notices only show while the
# machine's audio is muted or low — no silent text popping over your music.
# Needs wpctl (WirePlumber); if it can't be read, notices always show.
# REMIX_NOTICE_GATE=1      # 0 = old always-show behavior
# REMIX_QUIET_VOLUME=0.15  # sink volume at or below this counts as "low"

# Push-to-talk ears (all local). Needs: faster-whisper (in the venv) and a recorder:
#   parec (pipewire-pulse) / pw-record / arecord. First run downloads the whisper model
#   once (tiny.en); after that nothing leaves the machine.
# REMIX_PTT=1  REMIX_PTT_MODEL=base.en  REMIX_PTT_LANGUAGE=
# (tiny.en = default config fallback, smallest; base.en is the accuracy pick
#  fit comfortably on a 2 GB-free disk - REMIX value wins over default)
# REMIX_PTT_REC_CMD=auto   # or a command that writes raw s16le 16k mono PCM to stdout
# REMIX_PTT_MAX_PRESS_S=15 # the brain closes the mic itself after this long

# Awareness (Phase 6): she senses the focused app (NAME only), user idle, AC
# power, audio state. Senses fail-soft; Hyprland-only for window/idle.
# REMIX_AWARENESS=1           # 0 = no sensing (proactive lines go quiet too)
# REMIX_AWARENESS_INTERVAL_S=5
# PRIVACY: window titles NEVER reach Jev/the LLM by default — only the app
# class name does. Opt a class in and its title passes (still scrubbed of
# emails/URLs/IPs/paths): e.g. video players or music players only.
# REMIX_TITLE_ALLOW=mpv,spotify,strawberry
# THE OPT-IN-EVERYTHING SWITCH ("I know what I'm doing"):
# REMIX_TITLES=off     # default — nothing passes
# REMIX_TITLES=scrub   # every title, still scrubbed of emails/URLs/IPs/paths
# REMIX_TITLES=raw     # every title untouched. They go into the CLOUD LLM
#                      # prompts (z.ai free endpoint) and she may read them
#                      # out loud. Scrub mode exists because raw titles often
#                      # carry tokens; pick raw only if you're fine with that.

# Unprompted lines ("random speech triggers", proactive.py): the TRIGGER is
# local and $0 (never Jev); the WORDS are written fresh by the same $0
# right-brain pool her replies use — grounded, screened, deduped. No
# pre-written pools; a failed generation = she stays quiet.
# Default cadence: max one line / 20 min, 8/day, never while fullscreen
# (DND), never during/right after an exchange, never while the mic is open.
# REMIX_PROACTIVE=1          # 0 = off (also toggled at runtime: /quiet)
# REMIX_PROACTIVE_MIN_GAP_S=1200
# REMIX_PROACTIVE_MAX_PER_DAY=8
# REMIX_CHATTER_TIMEOUT_S=25 # give up on the words after this; silence instead
# REMIX_IDLE_GENTLE_S=900    # 15 min idle -> "still there?"
# REMIX_IDLE_DEEP_S=2700     # 45 min -> soft concerned check-in
# REMIX_AWAY_S=1800          # 30 min away -> welcome back on return
# REMIX_MUTED_NAG_S=600      # muted 10 min -> she comments
# REMIX_SESSION_LONG_S=10800 # 3 h session -> stretch nudge
# REMIX_APP_STUCK_S=5400     # 90 min in one app -> variety comment
# REMIX_QUIET_HOURS=         # "1-8" = no unprompted lines 01:00-08:59

# Debug commands (type them at her, they never reach any LLM):
#   /poke   say something unprompted now     /aware   show the redacted snapshot
#   /quiet  toggle unprompted chatter
