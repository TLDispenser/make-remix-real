# Local runtime configuration for Remix. Never commit .env (gitignored).
# Commented values below match the built-in defaults in brain/config.py.
# Interactive editor (edits .env in place, secrets never shown): ./settings.sh

# ---- Left brain (System 1 — Jev) ----
# Early-access key from console.typesafe.ai/keys.
# RuleBrain fallback activates automatically when this is absent.
JEV_API_KEY=
# JEV_URL=https://api.typesafe.ai/v1/systemone
# JEV_MODEL=jev-latest
# JEV_TIMEOUT_S=3.0

# Jev credit budget (RuleBrain handles silent/background ticks cleanly when
# capped; these cap reactions to user input / flagged events):
# REMIX_JEV_COOLDOWN_S=3
# REMIX_JEV_MAX_PER_HOUR=60
# REMIX_JEV_CACHE_TTL_S=300
# REMIX_JEV_PROACTIVE_MAX_PER_HOUR=20  # silent-life Jev ceiling

# Face variety & blush (Jev): sample from Jev's probabilities, discount recent
# faces. Blush is a noul alongside eyes/mouth (same request, $0).
# Her faces cost Jev calls: one per exchange to react, plus one more when her
# line has 2+ beats (it needs her actual words). Both count toward MAX_PER_HOUR.
# REMIX_JEV_FACE_TEMPERATURE=1.0   # lower = predictable, higher = varied
# REMIX_JEV_REPEAT_PENALTY=0.55    # weight multiplier per recent repeat; 1 = off
# REMIX_BLUSH_BASELINE=0.0         # floor on the wire (1.0 = always-on hatching)
# REMIX_JEV_BLUSH=1                # 0 = disable Jev blush noul
# REMIX_JEV_BLUSH_THRESHOLD=0.5    # noul at/above this becomes visible blush

# ---- The seam (decision modes: off | shadow | live) ----
#   off     local behavior (also forced when JEV_API_KEY is empty)
#   shadow  Jev answers beside local logic; logged only, local still ships
#   live    Jev's answer ships; local stays as the failure fallback
# Review with /why; flip at runtime with /decisions <kind> <mode>.
REMIX_JEV_DECIDE_STANCE=live
REMIX_JEV_DECIDE_SPEAK=live
# REMIX_JEV_SPEAK_P=0.6              # live should_speak ships at/above this
# REMIX_JEV_DECIDE_FORM=shadow       # speak / caption / look / quiet
# REMIX_JEV_JUDGE_GROUNDING=shadow   # unseen-judge vs local word list
# REMIX_JEV_DECIDE_INTENT=shadow     # user intent (question/command/chitchat/...)
REMIX_JEV_JUDGE_DODGE=live
# REMIX_JEV_DODGE_THRESHOLD=0.7      # live dodge judge ships a retry at/above
# REMIX_JEV_DECIDE_COMMITMENT=shadow # promise/reminder detection
# REMIX_JEV_COMMIT_P=0.6             # live commitment records at/above this
# REMIX_JEV_RANK_MEMORY=off          # Jev-ranked memory retrieval (FTS default)
# REMIX_JEV_DECIDE_ESCALATE=shadow   # start attention ladder? (live = rungs 2-3)
# REMIX_JEV_DECIDE_MUTE=shadow       # dry beat on mute/unmute? (live = LLM line)
# REMIX_DECISIONS_LOG=1              # rotating brain/decisions.log
# REMIX_DECISIONS_LOG_MAX_BYTES=524288

# ---- Right brain (System 2 — $0 LLM provider pool) ----
# Primary: Z.ai's GLM-4.7-Flash ($0 free tier).
REMIX_LLM_API_KEY=
REMIX_LLM_BASE_URL=https://api.z.ai/api/paas/v4
REMIX_LLM_MODEL=glm-4.7-flash
# REMIX_LLM_TIMEOUT_S=45
# REMIX_LLM_PROVIDER_COOLDOWN_S=600  # cooldown after 2 failed attempts (s)
# REMIX_LLM_STREAM=1                 # 0 = one-shot replies only (no sentence-1 streaming)
# REMIX_HISTORY_MAX_MESSAGES=20      # conversation context window (10 exchanges)

# Swap/fallback pool (see speech.py). Every provider in the pool must be $0.
# NOTE: gemini-2.5-flash is deprecated for new users (2026-10); free-tier
# models verified 2026-11-06 (see ../docs/RESEARCH_NOTES.md):
#   gemini-3.5-flash-lite  <- recommended (high-volume simple tasks)
#   gemini-3.8-flash       <- smartest Flash, also free tier
#   gemini-3.6-flash       <- previous-gen Flash, also free tier
REMIX_LLM_BACKUP1_URL=https://generativelanguage.googleapis.com/v1beta/openai
REMIX_LLM_BACKUP1_MODEL=gemini-3.5-flash-lite
REMIX_LLM_BACKUP1_API_KEY=
# More backups: increment the number (REMIX_LLM_BACKUP2_URL / _MODEL / _API_KEY).

# ---- Identity, mood & unprompted chatter ----
# REMIX_USER_NAME=                   # what she calls you in instruction context (empty = "you")
# REMIX_TEMPER=cranky                # cranky | balanced | soft
# REMIX_MOODS=1                      # 0 = static temper; 1 = earned mood nudges + drift + decay
# REMIX_TEMPER_REHOUR=6              # re-roll per-boot drift every N hours
# REMIX_AWAKEN_MIN_S=120             # min shut-down gap for an awaken greeting (s)

# Unprompted lines (proactive.py): local $0 triggers; fresh words from the
# right-brain pool (grounded, screened, deduped — failure = silence).
# REMIX_PROACTIVE=1                  # 0 = off (also toggled live via /quiet)
# REMIX_PROACTIVE_TICK_S=20
# REMIX_PROACTIVE_MIN_GAP_S=1200     # 20 min minimum spacing between lines
# REMIX_PROACTIVE_MAX_PER_DAY=8      # hard daily cap
# REMIX_PROACTIVE_JITTER=0.25        # cooldown/gap wobble (0 = exact timings)
REMIX_PROACTIVE_OPEN_P=0.4
REMIX_ON_MIND_COOLDOWN_S=10800
# REMIX_AMBIENT_RATE=0.02            # per-tick chance of an idle ambient musing
# REMIX_AMBIENT_COOLDOWN_S=3000      # >= 50 min between ambient musings
# REMIX_CHATTER_TIMEOUT_S=45         # drop unprompted words if generation exceeds this
# REMIX_IDLE_GENTLE_S=900            # 15 min idle -> "still there?"
# REMIX_IDLE_DEEP_S=2700             # 45 min idle -> soft check-in
# REMIX_AWAY_S=1800                  # 30 min away -> welcome back on return
# REMIX_MUTED_NAG_S=600              # muted 10 min -> she comments
# REMIX_SESSION_LONG_S=10800         # 3 h session -> stretch nudge
# REMIX_APP_STUCK_S=5400             # 90 min in one app -> variety nudge
# REMIX_QUIET_HOURS=                 # e.g. "1-8" = no unprompted lines 01:00-07:59

# ---- Voice out (espeak-ng, NOT an AI voice) ----
# Arch: pacman -S espeak-ng
# REMIX_TTS=1
# REMIX_TTS_BIN=espeak-ng
# REMIX_TTS_VOICE=en-us+f3
# REMIX_TTS_SPEED=160
# REMIX_TTS_PITCH=42
# REMIX_TTS_AMP=120
# REMIX_TTS_BEAT_GAP_S=0.2
# REMIX_TTS_PROSODY=1                # per-beat speed/pitch leaning
# REMIX_TTS_EXPRESSIVE=1             # 0 = fixed voice; 1 = follows per-beat mood/emphasis
# REMIX_TTS_EXPRESSIVENESS=1.0       # 0.5 = subtler, 2.0 = theatrical (0..2)
# REMIX_TTS_DSP=1                    # 0 = espeak only (no tremble/muffle/glitch/sigh DSP)
# REMIX_TTS_STRAIN=1                 # 0 = never glitch with hot/pegged hardware
# REMIX_TTS_DIR=                     # default: $XDG_RUNTIME_DIR/remix-voice (or /tmp)
# REMIX_SUBTITLES=auto               # auto = captions only when unvoiced; always | never
REMIX_CHATTER_VOICE=always

# ---- Ears: push-to-talk + reacting while you type/speak ----
# REMIX_PTT=1
REMIX_PTT_MODEL=base.en
# REMIX_PTT_LANGUAGE=                # empty = autodetect ("en" for *.en models)
# REMIX_PTT_REC_CMD=auto             # "auto" (prefers pw-record, then parec, arecord) or command
# REMIX_PTT_SOCK=                    # default: $XDG_RUNTIME_DIR/remix-ptt.sock
# REMIX_PTT_MIN_PRESS_S=0.3          # shorter presses discarded
# REMIX_PTT_MAX_PRESS_S=15           # brain closes mic after this long even if key-up lost
# REMIX_PTT_MIN_PEAK=0.015           # below this peak = silence, skip whisper

# Listening (see README "Listening"):
# REMIX_LISTEN=1                     # local typing/speaking reflexes ($0)
# REMIX_LISTEN_TICK_S=0.25
# REMIX_LISTEN_PAUSE_S=0.9           # quiet this long = pause worth a peek
# REMIX_LISTEN_MIN_WORDS=4
# REMIX_LISTEN_REUSE_SLACK_WORDS=3   # final line may add this many words and reuse peek
# REMIX_LISTEN_STT_PARTIALS=1        # rolling Whisper while PTT key is held
# REMIX_LISTEN_STT_INTERVAL_S=1.0
# REMIX_LISTEN_STT_MIN_S=1.0
# REMIX_LISTEN_JEV=0                 # OPT-IN: Jev peeks mid-line (uses credits + cloud)
# REMIX_LISTEN_JEV_PER_EXCHANGE=2
# REMIX_LISTEN_JEV_MIN_GAP_S=2.0
# REMIX_LISTEN_JEV_RESERVE=20        # reserve this many hourly Jev calls before peeks

# ---- Memory & sandbox ----
# REMIX_SANDBOX_DIR=~/.local/share/remix/sandbox
REMIX_MEMORY_REPO=https://github.com/TLDispenser/Remixbox.git
REMIX_MEMORY_TOKEN=
# REMIX_MEMORY_SYNC_MIN_S=1800       # push cadence when dirty (s)
# REMIX_MEMORY_MAX_ENTRIES=1000
# REMIX_MEMORY_SEARCH_LIMIT=5        # FTS candidates retrieved per line
# REMIX_MEMORY_INJECT_LIMIT=6        # max retrieved rows merged into prompt
# Inbox watcher is OPT-IN (file excerpts are sent to the cloud LLM):
# REMIX_INBOX=0                      # 1 = watch inbox/ and react to new .txt files
# REMIX_INBOX_POLL_S=30
# REMIX_INBOX_EXCERPT_CHARS=400

# ---- Vitals & body ----
REMIX_MOCK=0
# REMIX_VITALS_INTERVAL_S=1.0
# REMIX_BODY_REFRESH_S=600           # slow probes: battery wear, SMART, kernel errors (no sudo)
# REMIX_TEMP_TINT=0                  # 1 = opt in to face colour following core temp
# REMIX_TEMP_ALARM_C=85
# REMIX_CPU_SPIKE=92
# REMIX_CPU_HIGH=75
# REMIX_CPU_FLAT=15
# REMIX_BATT_LOW=15
# REMIX_BATT_DROOP=35
# REMIX_DISK_FULL=90
# REMIX_POSE_CANDIDATE_N=3
# REMIX_POSE_MIN_HOLD_S=4
# REMIX_NOTICE_MIN_GAP_S=240
# REMIX_NOTICE_GATE=1                # flavor notices only while muted/low volume (wpctl)
# REMIX_QUIET_VOLUME=0.15            # sink volume <= this counts as "low"
# REMIX_AUDIO_GATE_TTL_S=5

# ---- Awareness, privacy & desktop integration ----
# REMIX_AWARENESS=1                  # 0 = no sensing (proactive lines go quiet too)
# REMIX_AWARENESS_INTERVAL_S=5
# Window title privacy filter (two layers that compose):
#   REMIX_TITLE_ALLOW=                 # allowlisted classes (e.g. mpv,spotify,strawberry)
#                                      # whose titles pass even in off mode (always scrubbed)
#   REMIX_TITLES=<off|scrub|raw>       # off = allowlist only | scrub = all scrubbed | raw = untouched
REMIX_TITLES=scrub
# REMIX_SURROUNDINGS=1               # nearest windows (class names + geometry; titles gated above)
# REMIX_SURROUNDINGS_MAX=8
# REMIX_SELF_MATCH=remix             # comma list matching class or title in `hyprctl clients`
# REMIX_WINDOW_POS=1                 # 0 = ignore Godot window pos (for compositors reporting junk)
# REMIX_APP_EVENTS=1                 # notice app launches & quits (class names only)

# Laptop bits + attention ladder + mute reflex:
# REMIX_BITS=1                       # lid, sleep, lock, headphones, hdmi, bt, wifi, usb, screenshots
# REMIX_AUDIO_EVENTS=1               # pactl subscribe event source for mute
# REMIX_RESUME_MIN_S=120             # wall-time gap that counts as "she was asleep"
# REMIX_SCREENSHOT_DIRS=~/Pictures/Screenshots   # colon-separated
# REMIX_URGENT=1                     # urgent window marker when muted/ignored
# REMIX_OOS_URGENT=1                 # rung 1: urgent marker when she speaks out of sight
# REMIX_ESCALATE_NOTIFY=1            # rung 2: notify-send with urgency set
# REMIX_ESCALATE_DISPATCH=0          # rung 3: hyprctl focuswindow (STEALS FOCUS — opt-in)
# REMIX_ESCALATE_NOTIFY_COOLDOWN_S=300
# REMIX_ESCALATE_DISPATCH_COOLDOWN_S=600
# REMIX_NOTIFY_TIMEOUT_S=8000        # notify-send -t (ms)
# REMIX_MUTE_REACT_COOLDOWN_S=900    # floor between dry beats on mute/unmute

# Shell hook (OPT-IN: command lines go to the cloud LLM after redaction/capping).
# REMIX_SHELL_HOOK=0                 # 1 = listen on the unix socket
# REMIX_SHELL_SOCK=                  # default: $XDG_RUNTIME_DIR/remix/shell.sock
# REMIX_SHELL_MIN_S=5
# REMIX_SHELL_MAX_CMD=120
# REMIX_SHELL_COOLDOWN_S=180

# Self-improvement (mechanic): spawns `opencode run --auto` in an isolated git
# worktree and leaves a branch for you to merge.
REMIX_MECHANIC=shadow
# REMIX_MECHANIC_TICK_S=120
# REMIX_MECHANIC_REST_S=86400        # min rest after any visit (s)
# REMIX_MECHANIC_THRESHOLD=8         # symptom score required
# REMIX_MECHANIC_DIARY_CHARS=400

# ---- Face link (WebSocket Python -> Godot) ----
# REMIX_WS_HOST=127.0.0.1
# REMIX_WS_PORT=8765

# ---- Debug commands (type them at her; never sent to any LLM) ----
#   /poke                      say something unprompted now
#   /aware                     show the redacted awareness snapshot
#   /listen                    listening stats (lead time, hit rate)
#   /quiet                     toggle unprompted chatter
#   /why                       recent decision log entries
#   /decisions [kind mode]     view or flip seam decision modes live
#   /memory [topic]            show what memories would be injected now
#   /forget <topic>            remove matching memory notes
#   /remember                  pause/resume memory recording this session
