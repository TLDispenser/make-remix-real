# Copy to .env and fill what you have. Never commit .env (ground rule).
# Keys only in .env or environment. This file is the template.
# Naming note (2026-11-08): settings are REMIX_* now; the old CORE_* names
# are still read, so an existing .env keeps working until you rename.

# Left brain (System 1) — Jev early access key from console.typesafe.ai/keys
# RuleBrain fallback activates automatically when this is absent.
JEV_API_KEY=

# Right brain (System 2) — default is Z.ai's GLM-4.7-Flash: $0 forever.
# Free key from https://z.ai (or open.bigmodel.cn); put it here, no card needed.
REMIX_LLM_API_KEY=

# Right brain = provider POOL (see speech.py). Primary:
REMIX_LLM_BASE_URL=https://api.z.ai/api/paas/v4
REMIX_LLM_MODEL=glm-4.7-flash

# Swap/FALLBACK pool. speech.py rotates providers when one proves stuck
# (e.g. z.ai's intermittent free-tier 429 "1305"): after 2 failed attempts a
# provider cools down 10 min (REMIX_LLM_PROVIDER_COOLDOWN_S) and rotation
# happens immediately. Every provider in the pool must be $0 (ground rule).
# Gemini free-key how-to: aistudio.google.com -> Get API key.
# NOTE: gemini-2.5-flash is DEAD for new users (deprecated 2026-10); free-tier
# models verified from the pricing page 2026-11-06 (see RESEARCH_NOTES.md):
#   gemini-3.5-flash-lite  <- recommended (high-volume simple tasks; what
#                             2.5-flash routes into)
#   gemini-3.8-flash       <- smartest Flash, also free tier
#   gemini-3.6-flash       <- previous-gen Flash, also free tier
REMIX_LLM_BACKUP1_URL=https://generativelanguage.googleapis.com/v1beta/openai
REMIX_LLM_BACKUP1_MODEL=gemini-3.5-flash-lite
REMIX_LLM_BACKUP1_API_KEY=
# More backups: increment the number (BACKUP2_URL / _MODEL / _API_KEY).

# Phase 2: vitals feed (0 = real psutil — the default; 1 = synthetic demo)
REMIX_MOCK=0

# Jev credit budget (user: limited credits). Defaults are in config.py;
# tighten here if needed. Silent life never calls Jev, so these cap only
# reactions to user input / flagged events.
# REMIX_JEV_COOLDOWN_S=3
# REMIX_JEV_MAX_PER_HOUR=60
# REMIX_JEV_CACHE_TTL_S=300

# Face variety (Jev): sample from Jev's probabilities, discount recent faces.
# REMIX_JEV_FACE_TEMPERATURE=1.0   (lower = more predictable, higher = more varied)
# REMIX_JEV_REPEAT_PENALTY=0.55    (weight multiplier per recent repeat; 1 = off)
# Her faces cost Jev calls: one per exchange to react, plus one more when her line
# has 2+ beats (it needs her actual words). Both count toward REMIX_JEV_MAX_PER_HOUR.

# Voice out: espeak-ng (NOT an AI voice). Arch: pacman -S espeak-ng
# REMIX_TTS=1  REMIX_TTS_VOICE=en-us+f3  REMIX_TTS_SPEED=160  REMIX_TTS_PITCH=42
# REMIX_SUBTITLES=auto   # auto = captions only when she has no voice; always | never

# On-screen text rule (2026-11-08): her rare flavor notices only show while the
# machine's audio is muted or low — no silent text popping over your music.
# Needs wpctl (WirePlumber); if it can't be read, notices always show.
# REMIX_NOTICE_GATE=1      # 0 = old always-show behavior
# REMIX_QUIET_VOLUME=0.15  # sink volume at or below this counts as "low"

# Push-to-talk ears (all local). Needs: faster-whisper (in the venv) and a recorder:
#   pw-record (works on this host) / parec / arecord. Autodetect = REMIX_PTT_REC_CMD=auto
#   (it prefers pw-record: parec streamed 0 bytes on this PipeWire 1.6.8, 2026-11-08 probe).
#   First run downloads the whisper model once (tiny.en config default; this install
#   runs base.en); after that nothing leaves the machine.
# REMIX_PTT=1  REMIX_PTT_MODEL=base.en  REMIX_PTT_LANGUAGE=
# REMIX_PTT_REC_CMD=auto    # recorder: "auto" or a whole command writing raw
#                           # s16le/16 kHz/mono PCM to stdout
# REMIX_PTT_MAX_PRESS_S=15  # the brain closes the mic itself after this long

# ---- memory sandbox (Nov-8 round) ----
# REMIX_SANDBOX_DIR=~/.local/share/remix/sandbox    # her journal lives here by
#                              # default now (XDG data, OUTSIDE the project
#                              # tree — 2026-11-11). The old in-tree
#                              # brain/sandbox/ is migrated automatically on
#                              # first run if the new spot is empty.
# REMIX_MEMORY_REPO=https://github.com/you/remix-sandbox.git   (make it PRIVATE)
# REMIX_MEMORY_TOKEN=   # fine-grained PAT: contents read/write on that repo
# REMIX_MEMORY_SYNC_MIN_S=1800        # push cadence when dirty
# REMIX_TEMPER=cranky                 # cranky | balanced | soft
# REMIX_AWAKEN_MIN_S=120              # min shut-down gap for an awaken line
# REMIX_AMBIENT_RATE=0.03             # chance per eligible tick for a musing
# REMIX_TTS_PROSODY=1                 # per-beat speed/pitch leaning (espeak)
# REMIX_URGENT=1                      # "urgent" marker when muted/ignored (6.4)

# Awareness (Phase 6): she senses the focused app (NAME only), user idle, AC
# power, audio state. Senses fail-soft; Hyprland-only for window/idle.
# REMIX_AWARENESS=1           # 0 = no sensing (proactive lines go quiet too)
# REMIX_AWARENESS_INTERVAL_S=5
# Privacy shim for window titles (two layers that compose):
#   REMIX_TITLE_ALLOW=mpv,spotify,strawberry   <- the pinhole: only those
#       classes' titles pass (always scrubbed of emails/URLs/IPs/paths).
#       Works in EVERY mode, including the default switch value below.
#   REMIX_TITLES=<off|scrub|raw>               <- the master switch.
#       off (default)  only the pinhole above passes, nothing else
#       scrub          every title passes, still scrubbed of
#                      emails/URLs/IPs/paths
#       raw            every title untouched, 200-char cap (a safety rail,
#                      not redaction). They go into the cloud LLM prompts
#                      and she may read them aloud. Raw titles often carry
#                      tokens; pick raw only if you're fine with that.
# (Set the variable ONCE and give it one value — e.g. REMIX_TITLES=scrub.)

# Surroundings: she knows which windows are around hers and where (app CLASS
# names + positions only; titles still obey REMIX_TITLES / REMIX_TITLE_ALLOW).
# Hyprland-only. They ride in the cloud LLM prompt like the focused app does.
# REMIX_SURROUNDINGS=1       # 0 = she only knows the focused app, as before
# REMIX_SURROUNDINGS_MAX=8   # nearest N windows on her screen
# REMIX_SELF_MATCH=remix     # how her own window shows in `hyprctl clients`
#                            # (class OR title, comma list). Running from the
#                            # Godot editor? Add that title, e.g. remix,Remix (DEBUG)

# Where-she-is (Nov-9): Godot's `context` message now carries "pos" (her
# window's position WITHIN the screen she's on) + screen_count; she gets it
# as plain placement words ("parked in the top-right area of the 1920x1080
# screen, screen 2 of 2"), re-reported whenever you move her window.
# Set 0 if your compositor reports junk positions — she'll then honestly
# say she isn't told where she's parked.
# REMIX_WINDOW_POS=1         # 0 = ignore pos entirely

# App events (Nov-11): she notices launches and quits ("they just opened
# kitty") — program CLASSES only, never titles. Also drives her glancing
# toward a window that just opened before she speaks.
# REMIX_APP_EVENTS=1         # 0 = the open-app sense is skipped entirely

# ---- The seam (Nov-11, Upgrade Plan V2): decision modes ----
# Every decision that can move from the program to Jev has a mode:
#   off     today's local behavior (also forced when JEV_API_KEY is empty)
#   shadow  Jev answers beside the local logic, but ONLY the log uses it
#   live    Jev's answer ships; local stays as the failure fallback
# Review with /why; flip at runtime with /decisions <kind> <mode>.
# REMIX_JEV_DECIDE_STANCE=shadow     # unprompted-line stance (menu unchanged)
# REMIX_JEV_DECIDE_SPEAK=shadow      # should-speak (noul, threshold below)
# REMIX_JEV_DECIDE_FORM=shadow       # speak/caption/look/quiet
# REMIX_JEV_JUDGE_GROUNDING=shadow   # unseen-judge vs the local word list
# REMIX_JEV_DECIDE_INTENT=shadow     # user intent (question/command/chitchat/...)
# REMIX_JEV_JUDGE_DODGE=shadow       # did the reply dodge a question/command?
# REMIX_JEV_DECIDE_COMMITMENT=shadow # promise/reminder detection (live = records one)
# REMIX_JEV_RANK_MEMORY=off          # Jev-ranked memory retrieval (FTS default)
# REMIX_JEV_DODGE_THRESHOLD=0.7      # live dodge judge ships a retry at/above
# REMIX_JEV_COMMIT_P=0.6             # live commitment records at/above this
# Blush: the cheek-hatching overlay, the third part of every face. Jev answers
# a blush noul BESIDE the eyes/mouth it already picks (same request, $0).
# BLUSH_BASELINE floors the level on the wire (1.0 = the old always-on look).
# REMIX_BLUSH_BASELINE=0.0
# REMIX_JEV_BLUSH=1                  # ask the blush noul at all
# REMIX_JEV_BLUSH_THRESHOLD=0.5      # noul at/above this becomes a visible blush
# Note: the bashful pose always blushes (1.0) while JEV_BLUSH is on — the pose
# table defines bashful AS blushing; the noul decides every other face.
# ---- Phase 4 (plan 2.3): bits + escalation + mute reflex ----
# REMIX_BITS=1                       # the laptop bits at all (lid/sleep/lock/...)
# REMIX_AUDIO_EVENTS=1               # pactl subscribe event source for mute
# REMIX_RESUME_MIN_S=120             # wall-gap that counts as "she was asleep"
# REMIX_SCREENSHOT_DIRS=~/Pictures/Screenshots   (colon-separated)
# REMIX_OOS_URGENT=1                 # local rung 1: bar glows when she says something out of sight
# REMIX_ESCALATE_NOTIFY=1            # rung 2: notify-send with urgency set
# REMIX_ESCALATE_DISPATCH=0          # rung 3: hyprctl focuswindow (steals focus — opt-in)
# REMIX_ESCALATE_NOTIFY_COOLDOWN_S=300
# REMIX_ESCALATE_DISPATCH_COOLDOWN_S=600
# REMIX_MUTE_REACT_COOLDOWN_S=900    # floor between dry beats on mute/unmute
# REMIX_JEV_DECIDE_ESCALATE=shadow   # start the attention ladder? (live starts rungs 2-3)
# REMIX_JEV_DECIDE_MUTE=shadow       # dry beat on mute/unmute? (live ships an LLM-written line)
# REMIX_JEV_SPEAK_P=0.6              # live should_speak ships at/above this
# REMIX_JEV_PROACTIVE_MAX_PER_HOUR=20  # silent-life Jev ceiling
# REMIX_DECISIONS_LOG=1              # rotating brain/decisions.log
# REMIX_PROACTIVE_JITTER=0.25        # cooldown/gap wobble so she isn't a cron job

# Memory core (Phase 3): SQLite FTS5 index next to the journal + retrieval
# limits + the conversation window. /memory shows what she'd inject now,
# /forget <topic> removes notes, /remember pauses recording (this session).
# REMIX_MEMORY_SEARCH_LIMIT=5        # FTS candidates retrieved per line
# REMIX_MEMORY_INJECT_LIMIT=6        # max retrieved rows merged into the prompt
# REMIX_HISTORY_MAX_MESSAGES=20      # conversation context (last 10 exchanges)

# Expressive voice: her voice follows the face she makes for each beat (flat when
# deadpan, sing-song when smug, shaky when scared, slow+muffled when tired), with
# emphasis (*word*, CAPS), pauses, (whispered asides), *sigh*, and glitchiness when
# the machine is truly strained. espeak-ng + plain DSP: still NOT an AI voice.
# REMIX_TTS_EXPRESSIVE=1       # 0 = the exact old fixed voice
# REMIX_TTS_EXPRESSIVENESS=1.0 # 0.5 = subtler, 2.0 = theatrical (0..2)
# REMIX_TTS_DSP=1              # 0 = espeak only (no tremble/muffle/glitch/sigh clip)
# REMIX_TTS_STRAIN=1           # 0 = voice never glitches with hot/pegged hardware

# Unprompted lines ("random speech triggers", proactive.py): the TRIGGER is
# local and $0 (never Jev); the WORDS are written fresh by the same $0
# right-brain pool her replies use — grounded, screened, deduped. No
# pre-written pools; a failed generation = she stays quiet.
# Default cadence: max one line / 20 min, 8/day, never while fullscreen
# (DND), never during/right after an exchange, never while the mic is open.
# REMIX_PROACTIVE=1          # 0 = off (also toggled at runtime: /quiet)
# REMIX_PROACTIVE_MIN_GAP_S=1200
# REMIX_PROACTIVE_MAX_PER_DAY=8
# REMIX_CHATTER_TIMEOUT_S=45 # give up on the words after this; silence instead
#                            # (25 starved z.ai free tier: every attempt died
#                            #  at 25 s in the 2026-11-08 log)
# REMIX_IDLE_GENTLE_S=900    # 15 min idle -> "still there?"
# REMIX_IDLE_DEEP_S=2700     # 45 min -> soft concerned check-in
# REMIX_AWAY_S=1800          # 30 min away -> welcome back on return
# REMIX_MUTED_NAG_S=600      # muted 10 min -> she comments
# REMIX_SESSION_LONG_S=10800 # 3 h session -> stretch nudge
# REMIX_APP_STUCK_S=5400     # 90 min in one app -> variety comment
# REMIX_QUIET_HOURS=         # "1-8" = no unprompted lines 01:00-08:59

# Listening (she reacts while you type/talk; see README "Listening")
# REMIX_LISTEN=1                  # local reflexes: $0, nothing leaves the machine
# REMIX_LISTEN_STT_PARTIALS=1     # voice: rolling local Whisper while the key is held
# REMIX_LISTEN_STT_INTERVAL_S=1.0 # (costs CPU while held; 0-ish = lighter: raise this)
# REMIX_LISTEN_JEV=0              # OPT-IN: Jev peeks (credits; partial lines go to the cloud)
# REMIX_LISTEN_JEV_PER_EXCHANGE=2
# REMIX_LISTEN_JEV_MIN_GAP_S=2.0
# REMIX_LISTEN_JEV_RESERVE=20     # peeks stop this many calls before REMIX_JEV_MAX_PER_HOUR
# REMIX_LISTEN_PAUSE_S=0.9        # quiet this long = a pause worth a peek
# REMIX_LISTEN_MIN_WORDS=4
# REMIX_LISTEN_REUSE_SLACK_WORDS=3  # the final line may add this many words and still reuse

# Debug commands (type them at her, they never reach any LLM):
#   /poke   say something unprompted now     /aware   show the redacted snapshot
#   /quiet  toggle unprompted chatter        /listen  listening stats (lead time, hit rate)
